rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Written only by the sign-in worker (worker/), which uses a service
    // account and bypasses these rules. People can read their own record.
    match /users/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
