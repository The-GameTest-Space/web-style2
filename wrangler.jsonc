{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gtspace",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./dist",
    // Paths without a file (e.g. /games/some-slug) get index.html with a 200.
    "not_found_handling": "single-page-application",
    // Serve .html files at their own URL instead of redirecting to the path
    // without .html: Google's site verification file must answer with a 200.
    "html_handling": "none",
    // For the event pages the script serves (JSON-LD added to index.html).
    "binding": "ASSETS",
    // Only the API, the sitemap and event pages run the Worker script;
    // everything else is a static file.
    "run_worker_first": ["/api/*", "/sitemap.xml", "/events/*"]
  },
  // Event cover images (worker/src/covers.ts), KV namespace event_images.
  "kv_namespaces": [{ "binding": "COVERS", "id": "2986b2ae40cf40af8de5cf7b04840a15" }],
  // /api/* requests per client IP, counted per Cloudflare location.
  "ratelimits": [{ "name": "API_LIMIT", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
  // Secrets (set with `npx wrangler secret put <NAME>`, never committed):
  //   DISCORD_CLIENT_SECRET     Discord app OAuth2 client secret
  //   FIREBASE_SERVICE_ACCOUNT  Firebase service account key JSON
}
